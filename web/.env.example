# Copy to .env for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# "sheets" uses Google Sheets (production). "memory" runs a local demo with no Google setup.
STORE=sheets

# Google Cloud service account that reads/writes each school's spreadsheet.
# Paste the whole JSON key file on one line, or as base64 of the file.
GOOGLE_SERVICE_ACCOUNT_JSON=

# OAuth "Web application" client ID used for "Sign in with Google".
GOOGLE_CLIENT_ID=

# Long random string used to sign login cookies (e.g. output of: openssl rand -hex 32).
SESSION_SECRET=

# Spreadsheet that lists every school (tab "SCHOOLS": SLUG | NAME | SPREADSHEET_ID | STATUS).
REGISTRY_SPREADSHEET_ID=

# Comma-separated Gmail addresses of HASTECH staff who can open every school as SUPER_ADMIN.
HASTECH_SUPER_ADMINS=

# Optional: send guardian registration emails through Resend (https://resend.com).
RESEND_API_KEY=
EMAIL_FROM=

# Local development only (ignored on Vercel): lets the E2E tests sign in without Google.
AUTH_TEST_MODE=0
